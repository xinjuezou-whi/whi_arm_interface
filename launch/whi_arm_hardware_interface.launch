<?xml version="1.0"?>
<launch>
  <!-- argument -->
  <arg name="home" default="false"/>
  <arg name="close_loop" default="true"/>
  <arg name="arm" default="chin"/>
  <!--<arg name="type" default=""/>-->
  <arg name="type" default="_frame"/>
  <arg name="description_pkg" default="$(eval '$(find ' + arg('arm') + '_description)')"/>
  <arg name="config_pkg" default="$(eval '$(find ' + arg('arm') + '_moveit_config)')"/>

  <!-- params -->
  <rosparam file="$(find whi_arm_interface)/config/hardware_$(arg arm).yaml" command="load"/>
  <rosparam file="$(find whi_arm_interface)/config/controllers_$(arg arm).yaml" command="load"/>

  <!-- Load moveit joint limits config in separate namespace to get velocity limits -->
  <rosparam file="$(arg config_pkg)/config/joint_limits.yaml" command="load" ns="chin"/>

  <!-- Load universal robot description format (URDF) -->
  <param name="robot_description" command="$(find xacro)/xacro --inorder $(arg description_pkg)/urdf/$(arg arm)_arm$(arg type).urdf.xacro"/>

  <!-- The semantic description that corresponds to the URDF -->
  <param name="robot_description_semantic" textfile="$(arg config_pkg)/config/$(arg arm)_arm.srdf"/>

  <!-- Start hardware_interface node -->
  <node name="whi_arm_interface" pkg="whi_arm_interface" type="whi_arm_interface_node" output="screen">
    <param name="home" type="bool" value="true" if="$(arg home)"/>
    <param name="home" type="bool" value="false" unless="$(arg home)"/>
    <param name="close_loop" type="bool" value="true" if="$(arg close_loop)"/>
    <param name="close_loop" type="bool" value="false" unless="$(arg close_loop)"/>
    <param name="arm" value="$(arg arm)"/>
  </node>

  <!-- rosserial server -->
  <group if="$(eval arg('arm') == 'ar2')">
    <node pkg="rosserial_python" name="serial_node" type="serial_node.py" output="screen">
      <param name="~port" value="/dev/ttyACM0"/>
      <param name="~baud" value="115200"/>
    </node>
  </group>

  <!-- Start controllers -->
  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="/" 
        args="/$(arg arm)_arm/controllers/state
	          /$(arg arm)_arm/controllers/position"/>
</launch>
